    "test:calendar-offers": "bash scripts/test-calendar-offers.sh",
    "test:rate-limit": "bash scripts/test-rate-limit.sh",
    "postinstall": "patch-package && bash scripts/patch-expo-modules-core.sh && bash scripts/patch-expo-image-ios.sh"
